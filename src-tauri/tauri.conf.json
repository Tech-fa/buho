{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buho",
  "version": "1.1.0",
  "identifier": "com.appshell.desktop",
  "build": {
    "beforeDevCommand": "node scripts/fetch-node.mjs && node scripts/fetch-python.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-node.mjs && node scripts/fetch-python.mjs && npm run build",
    "beforeBundleCommand": "node scripts/sign-python.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Buho",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/node"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../sample-ui/": "sample-ui/",
      "../harness/": "harness/",
      "binaries/LICENSE": "node-license.txt",
      "binaries/python/": "python/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
